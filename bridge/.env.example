# Bridge secrets only. Copy to .env (git-ignored) and fill in.
# Non-secret settings belong in bridge/config.toml.
# The systemd service reads secrets from ~/.config/walkpad/secrets.env instead (same format);
# this file is for development runs (`uv run walkpad-bridge serve ...`).

# OpenRouteService key for the route planner (free at https://openrouteservice.org/dev/).
# Used only by the bridge; never put it in web/.env.
ORS_API_KEY=
