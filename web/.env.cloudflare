# Build settings for the Cloudflare deploy (walk.connectedovals.com): `npm run build:cloudflare`.
# Tracked in git on purpose: nothing here is secret. NEVER put a key or token in this file.
# Values set as build variables in the Cloudflare dashboard override these.

# The bridge, through the Cloudflare Tunnel. Setting it makes the page view-only (live + stats):
# belt control is only offered by the page the bridge itself serves on the LAN.
VITE_BRIDGE_URL=https://walkpad-bridge.connectedovals.com

# No Google 3D tiles on the public site (cost), and no key in its bundle (this overrides web/.env
# when building on the laptop).
VITE_WORLD_MODE=flat
VITE_GOOGLE_MAPS_API_KEY=
