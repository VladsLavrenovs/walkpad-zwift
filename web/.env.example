# Copy to web/.env (git-ignored). All web config lives here.
# NOTE: VITE_* values are embedded in the built JS bundle and are visible to anyone who can load the app.

# Bridge base URL (HTTP API + WebSocket). Leave EMPTY when the page is served by the bridge
# itself (http://<laptop>:8080) or by `npm run dev` (which proxies to BRIDGE_DEV_URL).
# Set it only for a separately hosted build, e.g. https://walkpad-bridge.connectedovals.com
VITE_BRIDGE_URL=

# Dev server only (not embedded in the bundle): where `npm run dev` proxies the bridge to.
BRIDGE_DEV_URL=http://localhost:8080

# World mode: "flat" (default, placeholder world, no Google requests) or "real" (Google 3D Tiles, costs money)
VITE_WORLD_MODE=flat

# Google Maps Platform API key for Photorealistic 3D Tiles. Restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
