# Copy to web/.env (git-ignored). All web config lives here.
# NOTE: VITE_* values are embedded in the built JS bundle and are visible to anyone who can load the app.

# Bridge base URL (HTTP API + WebSocket)
VITE_BRIDGE_URL=http://localhost:8000

# World mode: "flat" (default, placeholder world, no Google requests) or "real" (Google 3D Tiles, costs money)
VITE_WORLD_MODE=flat

# Google Maps Platform API key for Photorealistic 3D Tiles. Restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
